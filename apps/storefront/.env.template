# Publishable API key dari Medusa Admin (Settings > Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL backend Medusa
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# URL backend untuk server action (upload bukti transfer)
MEDUSA_BACKEND_URL=http://localhost:9000

# Kode region bawaan (Indonesia)
NEXT_PUBLIC_DEFAULT_REGION=id

# URL publik storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Opsional: Stripe, Medusa Payments, Adyen
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADYEN_CLIENT_KEY=
NEXT_PUBLIC_ADYEN_ENVIRONMENT=test

# Opsional: Medusa Cloud S3
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

NODE_ENV=development
